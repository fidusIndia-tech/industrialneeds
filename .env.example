APP_NAME=Laravel
# Production-safe defaults. For local development set APP_ENV=local and APP_DEBUG=true.
# NEVER run a public/production deployment with APP_DEBUG=true (leaks stack traces, env vars and API keys via Ignition).
APP_ENV=production
APP_KEY=base64:1vaU3dfc+sWjx8TuDXzginRsEa2dp2SBL+Ujs6QCb5c=
APP_DEBUG=false
APP_MODE=live
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=6valy_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

NEXMO_KEY=
NEXMO_SECRET=

PURCHASE_CODE=
BUYER_USERNAME=
SOFTWARE_ID=MzE0NDg1OTc=

# Search engine (Laravel Scout + Meilisearch).
# SCOUT_DRIVER=null keeps the app on DB search (no-op indexing) until Meilisearch
# is provisioned; switch to "meilisearch" then sync index settings + import.
SCOUT_DRIVER=null
SCOUT_QUEUE=false
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Deploy-proof media storage. Uploaded images must live OUTSIDE the deploy tree,
# otherwise a panel "Deploy" / re-clone of the web root deletes them. With the flag
# on, `storage:persist` (scheduled every minute) keeps storage/app/public symlinked
# to STORAGE_PERSISTENT_PATH and migrates back any stray files a deploy left behind.
# REQUIRED on the live server. Leave unset locally so Laragon keeps a normal folder.
STORAGE_PERSISTENT_LINK=false
# Defaults to a sibling of the project root: <parent-of-base_path>/persistent_public
STORAGE_PERSISTENT_PATH=

# Canonical base URL for the generated sitemap. Must be the live domain regardless
# of APP_URL. Defaults to https://industrialsupply.in when unset.
SITEMAP_BASE_URL=

# Where enquiry and quote-request alerts are delivered. Change this to redirect
# leads without a code change. Leave empty to stop sending them (leads are still
# saved to the database). This also drives the chatbot unless CHATBOT_LEAD_EMAIL
# is set below.
LEAD_NOTIFY_EMAIL=sales@fidusindia.com

# Optional: send chatbot leads somewhere separate from enquiry/quote alerts.
# Leave unset and the chatbot uses LEAD_NOTIFY_EMAIL.
CHATBOT_LEAD_EMAIL=
