/node_modules
/public/hot
/public/storage
/storage/*.key
/vendor
.idea
.env
.env.backup
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
# Universal block for node_modules in any sub-folder
**/node_modules

# Block non-standard heavy folders
/cache
/installation
/static

# Database dumps must never be committed or served from the web root
*.sql
*.sql.gz
/industrialneeds_db.sql

# Generated sitemap artifacts (produced by `php artisan sitemap:generate`)
/sitemap.xml
/sitemap-pages.xml
/sitemap-products-*.xml
# Ignore internal WordPress installations/themes
/chromo
/chromogenic